# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Compiler output, in case anyone builds in the working tree rather than in
# the temp directory the runner normally uses
*.exe
*.obj
*.o
*.pdb
*.ilk
*.dll

# Local per-user state: drafts and settings. Normally these live in
# ~/.crucible, but CRUCIBLE_HOME can point them at the project directory.
.crucible/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
